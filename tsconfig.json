{
	"extends": "./node_modules/$app/tsconfig.json",
	"include": ["src", "test", "*", ".svelte-kit/ambient.d.ts", ".svelte-kit/non-ambient.d.ts"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	}
	// `extends` apunta a la ruta real del config que genera SvelteKit en
	// `node_modules/$app/tsconfig.json` (lo escribe `svelte-kit sync`). Se usa la
	// ruta en disco, no el especificador virtual `$app/tsconfig`, para que
	// cualquier herramienta que solo sepa leer ficheros lo resuelva igual.
	//
	// Ese config ya declara los alias de `$lib`, así que aquí no se repiten.
	// Los alias nuevos van por subpath imports (#lib), no por `alias`.
}
