{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*", ".svelte-kit/ambient.d.ts", ".svelte-kit/non-ambient.d.ts"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	}
	// `$app/tsconfig` es la forma que documenta SvelteKit 3 y la que él mismo
	// exige si falta (`kit/tsconfig_extends_missing`). `svelte-kit sync` escribe
	// ese config en `node_modules/$app/tsconfig.json`, así que TypeScript lo
	// resuelve como un paquete real; por eso `check` y `build` lo cargan.
	//
	// Ese config ya declara los alias de `$lib`, así que aquí no se repiten.
	// Los alias nuevos van por subpath imports (#lib), no por `alias`.
}
