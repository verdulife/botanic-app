{
	"name": "botanic-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"img": "node --env-file-if-exists=.env.local scripts/images.mjs",
		"img:optimize": "node --env-file-if-exists=.env.local scripts/optimize-images.mjs",
		"img:seed": "node --env-file-if-exists=.env.local scripts/optimize-seed-images.mjs",
		"img:download": "node --env-file-if-exists=.env.local scripts/download-seed-images.mjs",
		"seed": "node --env-file-if-exists=.env.local scripts/seed-mock.ts",
		"seed:apply": "node --env-file-if-exists=.env.local scripts/seed-mock.ts --apply",
		"seed:wipe": "node --env-file-if-exists=.env.local scripts/wipe-mock.ts",
		"seed:wipe:dry": "node --env-file-if-exists=.env.local scripts/wipe-mock.ts --dry-run",
		"og": "node --env-file-if-exists=.env.local scripts/generate-og.mjs",
		"email:preview": "node --env-file-if-exists=.env.local scripts/email-preview.mjs",
		"email:send": "node --env-file-if-exists=.env.local scripts/email-send.mjs"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/canvas-confetti": "^1.9.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.6",
		"sharp": "^0.35.5",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.77.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.2",
		"@vite-pwa/sveltekit": "^2.0.3",
		"bits-ui": "^2.21.0",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"leaflet": "^1.9.4",
		"marked": "^18.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2"
	},
	"packageManager": "pnpm@12.21.0"
}
