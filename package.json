{
	"name": "botanic-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"logo:gen": "bun run scripts/render-logo.ts",
		"img": "bun run scripts/images.mjs",
		"img:optimize": "bun run scripts/optimize-images.mjs",
		"stock": "bun run scripts/stock.mjs",
		"frames": "bun run scripts/video-frames.mjs",
		"tokens": "bun run scripts/sync-brand-tokens.mjs",
		"fonts": "bun run scripts/copy-fonts.mjs",
		"lint:brand": "bun run scripts/lint-brand.mjs"
	},
	"devDependencies": {
		"@fontsource/onest": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/canvas-confetti": "^1.9.0",
		"@types/leaflet": "^1.9.21",
		"ffmpeg-static": "^5.3.0",
		"fontkit": "^2.0.4",
		"opentype.js": "^2.0.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource-variable/onest": "^5.3.0",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.110.8",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.18.1",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"leaflet": "^1.9.4",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.7",
