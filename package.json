{
	"name": "botanic-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"img": "node --env-file-if-exists=.env.local scripts/images.mjs",
		"img:optimize": "node --env-file-if-exists=.env.local scripts/optimize-images.mjs",
		"img:seed": "node --env-file-if-exists=.env.local scripts/optimize-seed-images.mjs",
		"img:download": "node --env-file-if-exists=.env.local scripts/download-seed-images.mjs",
		"seed": "node --env-file-if-exists=.env.local scripts/seed-mock.ts",
		"seed:apply": "node --env-file-if-exists=.env.local scripts/seed-mock.ts --apply",
		"seed:wipe": "node --env-file-if-exists=.env.local scripts/wipe-mock.ts",
		"seed:wipe:dry": "node --env-file-if-exists=.env.local scripts/wipe-mock.ts --dry-run",
		"og": "node --env-file-if-exists=.env.local scripts/generate-og.mjs",
		"email:preview": "node --env-file-if-exists=.env.local scripts/email-preview.mjs",
		"email:send": "node --env-file-if-exists=.env.local scripts/email-send.mjs"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/canvas-confetti": "^1.9.0",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^26.4.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.110.8",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.18.1",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"leaflet": "^1.9.4",
		"lucide-svelte": "^1.0.1",
		"marked": "^18.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2"
	},
	"packageManager": "pnpm@12.21.0"
}
